# Export this optional binary configuration with: set -a; . ./.env; set +a
# Docker Compose configures its environment in compose.yaml.

# Required base64 32-byte AEAD key; generate with make devkey.
PORTCULLIS_MASTER_KEY=

# Production prefers a mounted secret file.
# PORTCULLIS_MASTER_KEY_FILE=/run/secrets/portcullis_master_key

# Retain historical KEKs during/after key rotation; consecutive versions from 1.
# See docs/operations/key-rotation.md. Use one historical source, not both.
# PORTCULLIS_MASTER_KEY_PREVIOUS=1:<base64>
# PORTCULLIS_MASTER_KEY_PREVIOUS_FILE=/run/secrets/portcullis_master_key_previous

# Required metadata DSN; production uses a restricted portcullis_runtime member.
PORTCULLIS_DATABASE_URL=postgres://portcullis:portcullis@localhost:5432/portcullis?sslmode=disable

# Development only: permit the owner DSN above as runtime access (ADR-0009).
# Keep disabled in production.
# PORTCULLIS_ALLOW_PRIVILEGED_RUNTIME=true

# Set owner credentials only on a separate `portcullis migrate` process in production.
# The owner needs CREATEROLE unless the runtime role is pre-provisioned.
# PORTCULLIS_MIGRATE_DATABASE_URL=postgres://portcullis:portcullis@localhost:5432/portcullis?sslmode=disable

# true | false | unset; unset migrates only with MIGRATE_DATABASE_URL configured.
# Single-role development opts in explicitly; ALLOW_PRIVILEGED_RUNTIME has no effect.
# PORTCULLIS_STARTUP_MIGRATE=true

# Use a unique lowercase runtime role per installation on a shared cluster.
# PORTCULLIS_RUNTIME_ROLE=portcullis_runtime

# A bare port is normalized to :8080.
# PORTCULLIS_ADDR=8080

# Logging accepts debug | info | warn | error and json | text.
# PORTCULLIS_LOG_LEVEL=info
# PORTCULLIS_LOG_FORMAT=json


# PORTCULLIS_DRAIN_DELAY=0s
# PORTCULLIS_SHUTDOWN_TIMEOUT=15s

# Bound concurrent Argon2id hashes; each costs about 64 MiB.
# PORTCULLIS_ARGON2_MAX_CONCURRENT=2

# After THRESHOLD failures, double BASE lockout per further failure up to CAP with ±20% jitter.
# PORTCULLIS_LOGIN_BACKOFF_THRESHOLD=5
# PORTCULLIS_LOGIN_BACKOFF_BASE=1m
# PORTCULLIS_LOGIN_BACKOFF_CAP=15m

# Target connection test timeout; allowed range is 1s–60s.
# PORTCULLIS_CONNECTION_TEST_TIMEOUT=10s

# Execution validity starts at quorum or automatic approval; allowed range is 15m–168h.
# PORTCULLIS_APPROVAL_VALIDITY=24h

# Honor X-Forwarded-For only from these proxy CIDRs; leave empty for direct exposure.
# Configure this behind a proxy so users do not share its rate-limit bucket.
# PORTCULLIS_TRUSTED_PROXIES=10.0.0.0/8,192.168.0.0/16

# Optional first admin requires EMAIL and exactly one password source of at least 15 characters.
# Production prefers PASSWORD_FILE; remove bootstrap variables after initialization.
# Preserve password whitespace, except one trailing newline in mounted file input.
# PORTCULLIS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# PORTCULLIS_BOOTSTRAP_ADMIN_PASSWORD=
# PORTCULLIS_BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/portcullis_admin_password
# PORTCULLIS_BOOTSTRAP_ADMIN_DISPLAY_NAME=Admin

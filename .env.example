# Optional template for running the binary directly (.env is gitignored).
# After copying, export it explicitly: set -a; . ./.env; set +a
# Docker Compose uses the self-contained environment in compose.yaml instead.

# Base64 of a 32-byte AEAD master key. The server refuses to start without it.
# Generate one with: make devkey
PORTCULLIS_MASTER_KEY=

# Alternatively, point to a mounted secret file (preferred in production):
# PORTCULLIS_MASTER_KEY_FILE=/run/secrets/portcullis_master_key

# Metadata PostgreSQL DSN (required). In production use a least-privilege login
# user holding the portcullis_runtime role (it cannot mutate audit_events).
PORTCULLIS_DATABASE_URL=postgres://portcullis:portcullis@localhost:5432/portcullis?sslmode=disable

# DEV ONLY — leave commented in production. The DSN above is the schema owner,
# which fails the runtime-connection verification (ADR-0009: the server must not
# run with owner/superuser credentials). Uncomment this flag to downgrade that
# failure to a warning for local single-role development. It is commented by
# default so copying this template into production is fail-closed: the boot check
# stays enforced unless an operator explicitly opts out.
# PORTCULLIS_ALLOW_PRIVILEGED_RUNTIME=true

# Owner DSN migrations run with. RECOMMENDED PRODUCTION SHAPE: do NOT set this
# on the server — run `portcullis migrate` as a separate one-shot process (or
# the compose `migrate` service), the only place holding it, so the serving
# process never carries owner credentials (ADR-0009). If it IS set on the
# server, migrations still run at startup (compatibility). With neither this
# nor ALLOW_PRIVILEGED_RUNTIME set, the server skips startup migration.
# Single-role dev (DATABASE_URL = owner + ALLOW_PRIVILEGED_RUNTIME=true) keeps
# migrating at startup. The owner needs CREATEROLE (or provision the runtime
# role yourself beforehand — the migration skips creation when it exists).
# PORTCULLIS_MIGRATE_DATABASE_URL=postgres://portcullis:portcullis@localhost:5432/portcullis?sslmode=disable

# Whether `portcullis serve` applies migrations itself before serving:
# true | false | unset (unset = migrate only when MIGRATE_DATABASE_URL is set
# on this process). Deliberately independent of ALLOW_PRIVILEGED_RUNTIME —
# the security-debug flag never changes who migrates. Single-role dev wanting
# migrate-on-boot sets this to true explicitly.
# PORTCULLIS_STARTUP_MIGRATE=true

# Name of the least-privilege runtime DB role migrations create/grant. Roles are
# cluster-wide in PostgreSQL: give each install on a SHARED cluster its own name,
# or their privileges merge. Lowercase identifier only.
# PORTCULLIS_RUNTIME_ROLE=portcullis_runtime

# HTTP listen address. A bare port works too, e.g. 8080 (normalized to :8080).
# PORTCULLIS_ADDR=8080

# Logging: debug | info | warn | error, and json | text.
# PORTCULLIS_LOG_LEVEL=info
# PORTCULLIS_LOG_FORMAT=json

# Graceful shutdown tuning.
# PORTCULLIS_DRAIN_DELAY=0s
# PORTCULLIS_SHUTDOWN_TIMEOUT=15s

# Max concurrent Argon2id password hashes. Each costs ~64 MiB, so this bounds
# hashing memory under a login flood (default 2). Raise on hosts with more RAM.
# PORTCULLIS_ARGON2_MAX_CONCURRENT=2

# Progressive login backoff (ADR-0006). After THRESHOLD consecutive failed
# password attempts the account is locked for BASE, doubling per further
# failure up to CAP (±20% jitter). Defaults are the ADR-pinned values.
# PORTCULLIS_LOGIN_BACKOFF_THRESHOLD=5
# PORTCULLIS_LOGIN_BACKOFF_BASE=1m
# PORTCULLIS_LOGIN_BACKOFF_CAP=15m

# Per-attempt timeout for a target-database connection test — the dial, TLS
# handshake, authentication, and ping (ADR-0014). Default 10s, range [1s, 60s].
# PORTCULLIS_CONNECTION_TEST_TIMEOUT=10s

# Comma-separated CIDRs of trusted reverse proxies. Only for peers in these ranges
# is X-Forwarded-For honored to recover the real client IP for rate limiting;
# otherwise the direct peer IP is used. Leave empty for direct exposure. Set this
# when running behind a proxy/LB, or all users share one rate-limit bucket.
# PORTCULLIS_TRUSTED_PROXIES=10.0.0.0/8,192.168.0.0/16

    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "solid-js": "1.9.13",
    "sql-formatter": "15.9.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.2"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.12.1",

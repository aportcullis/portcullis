{
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "PostgreSQL images in the compatibility catalog and test harness",
      "managerFilePatterns": [
        "/^internal/infra/dbtest/postgres\\.go$/",
        "/^internal/infra/dbtest/images\\.go$/",
        "/^docs/media/capture\\.mjs$/"
      ],
      "matchStrings": [
        "\"(?<depName>postgres):(?<currentValue>[0-9][^\"@]*)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Group Go module updates into one PR",
      "matchManagers": [
        "gomod"
      ],
      "groupName": "go modules"
    },
    {
      "description": "Group frontend updates (the npm manager also handles pnpm)",
      "matchManagers": [
        "npm"
      ],
      "groupName": "frontend deps"
    },
    {
      "description": "Group base image updates (Dockerfile + compose + test harness strings)",
      "matchManagers": [
        "dockerfile",
        "docker-compose",
        "custom.regex"
      ],
      "groupName": "docker images"
    },
    {
      "description": "Keep the explicit PostgreSQL compatibility families; review major promotions separately",
      "matchManagers": [
        "custom.regex",
        "docker-compose"
      ],
      "matchDepNames": [
        "postgres"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Maintain PostgreSQL 19 preview builds without automatic GA promotion",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "postgres"
      ],
      "matchCurrentValue": "/^19beta[0-9]+$/",
      "versioning": "regex:^(?<major>19)beta(?<patch>[0-9]+)$",
      "allowedVersions": "/^19beta[0-9]+$/"
    }
  ],
  "minimumReleaseAge": "7 days",
  "automerge": false
}

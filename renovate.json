{
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "PostgreSQL images in the compatibility catalog and test harness",
      "managerFilePatterns": [
        "/^internal/infra/dbtest/postgres\\.go$/",
        "/^internal/infra/dbtest/images\\.go$/",
        "/^docs/media/capture\\.mjs$/"
      ],
      "matchStrings": [
        "\"(?<depName>postgres):(?<currentValue>[0-9][^\"@]*)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Pinned offline changelog generator",
      "managerFilePatterns": [
        "/^\\.github/scripts/git-cliff-image\\.sh$/"
      ],
      "matchStrings": [
        "GIT_CLIFF_IMAGE='(?<depName>ghcr.io/orhun/git-cliff/git-cliff):(?<currentValue>[0-9.]+)@(?<currentDigest>sha256:[a-f0-9]{64})'"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Pinned buf and sqlc code generators",
      "managerFilePatterns": [
        "/^\\.github/scripts/codegen-images\\.sh$/"
      ],
      "matchStrings": [
        "_IMAGE='(?<depName>[a-z0-9./-]+):(?<currentValue>[0-9.]+)@(?<currentDigest>sha256:[a-f0-9]{64})'"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Remote protobuf-go plugin pinned to the Go protobuf runtime",
      "managerFilePatterns": [
        "/^buf\\.gen\\.yaml$/"
      ],
      "matchStrings": [
        "remote: buf\\.build/protocolbuffers/go:v(?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "google.golang.org/protobuf",
      "datasourceTemplate": "go",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Remote connect-go plugin pinned to the Connect Go runtime",
      "managerFilePatterns": [
        "/^buf\\.gen\\.yaml$/"
      ],
      "matchStrings": [
        "remote: buf\\.build/connectrpc/go:v(?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "connectrpc.com/connect",
      "datasourceTemplate": "go",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Remote protobuf-es plugin pinned to the TypeScript protobuf runtime",
      "managerFilePatterns": [
        "/^buf\\.gen\\.yaml$/"
      ],
      "matchStrings": [
        "remote: buf\\.build/bufbuild/es:v(?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "@bufbuild/protobuf",
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "Group Go module updates into one PR",
      "matchManagers": [
        "gomod"
      ],
      "groupName": "go modules"
    },
    {
      "description": "Group frontend updates (the npm manager also handles pnpm)",
      "matchManagers": [
        "npm"
      ],
      "groupName": "frontend deps"
    },
    {
      "description": "Group base image updates (Dockerfile + compose + test harness strings)",
      "matchManagers": [
        "dockerfile",
        "docker-compose",
        "custom.regex"
      ],
      "groupName": "docker images"
    },
    {
      "description": "Keep the explicit PostgreSQL compatibility families; review major promotions separately",
      "matchManagers": [
        "custom.regex",
        "docker-compose"
      ],
      "matchDepNames": [
        "postgres"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Maintain PostgreSQL 19 preview builds without automatic GA promotion",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "postgres"
      ],
      "matchCurrentValue": "/^19beta[0-9]+$/",
      "versioning": "regex:^(?<major>19)beta(?<patch>[0-9]+)$",
      "allowedVersions": "/^19beta[0-9]+$/"
    }
  ],
  "minimumReleaseAge": "7 days",
  "automerge": false
}

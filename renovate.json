{
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Postgres image strings in the Go test harness (same digest as compose.yaml)",
      "managerFilePatterns": [
        "/^internal/infra/dbtest/postgres\\.go$/"
      ],
      "matchStrings": [
        "\"(?<depName>postgres):(?<currentValue>[0-9][^\"@]*)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Group Go module updates into one PR",
      "matchManagers": ["gomod"],
      "groupName": "go modules"
    },
    {
      "description": "Group frontend updates (the npm manager also handles pnpm)",
      "matchManagers": ["npm"],
      "groupName": "frontend deps"
    },
    {
      "description": "Group base image updates (Dockerfile + compose + test harness strings)",
      "matchManagers": ["dockerfile", "docker-compose", "custom.regex"],
      "groupName": "docker images"
    },
    {
      "description": "Pinned preview compiler — only manual bumps",
      "matchPackageNames": ["@typescript/native-preview"],
      "enabled": false
    }
  ]
}

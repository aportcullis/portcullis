# The caller supplies the single digest-pinned git-cliff image definition.
ARG GIT_CLIFF_IMAGE
FROM ${GIT_CLIFF_IMAGE}
USER root
# Git and Python are fixture tools, installed from the base distribution's signed repositories.
RUN apt-get update \
    && apt-get install --no-install-recommends -y git python3 \
    && rm -rf /var/lib/apt/lists/*
ENTRYPOINT ["bash"]

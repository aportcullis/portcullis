{
  "name": "portcullis-load-tests",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "bundle": "mkdir -p dist && esbuild governance.ts async-execution.ts result-limits.ts wire.test.ts --bundle --format=esm --platform=neutral --target=es2022 --external:k6 --external:k6/* --outdir=dist",
    "test": "node --test tests/*.test.ts",
    "lint": "oxlint --deny-warnings --config oxlint.json ."
  },
  "devDependencies": {
    "@types/k6": "2.3.0",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "imports": {
    "#load/*": "./*.ts"
  }
}
